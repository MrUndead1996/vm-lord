+/* Copies a scanout resource into the displaytarget its consumer scans out of.
+ *
+ * A scanout consumer -- gbm, and through it a KMS compositor -- was handed the
+ * displaytarget's DRM handle when it asked this resource for one, so the frame
+ * has to be in the displaytarget by the time the frame is handed over. The
+ * frontend flushes the back buffer before every swap, which is that moment.
+ *
+ * This is the same copy d3d12_flush_frontbuffer performs for a display target,
+ * without the presentation the winsys does afterwards: on a KMS device the
+ * consumer presents, not the winsys.
+ */
+static void
+d3d12_present_to_displaytarget(struct pipe_context *pctx,
+                               struct d3d12_resource *res)
+{
+   struct d3d12_screen *screen = d3d12_screen(pctx->screen);
+   struct sw_winsys *winsys = screen->winsys;
+   struct pipe_resource *pres = &res->base.b;
+
+   void *map = winsys->displaytarget_map(winsys, res->dt, 0);
+   if (!map)
+      return;
+
+   struct pipe_transfer *transfer = nullptr;
+   void *res_map = pipe_texture_map(pctx, pres, 0, 0, PIPE_MAP_READ, 0, 0,
+                                    pres->width0, pres->height0, &transfer);
+   if (res_map) {
+      util_copy_rect((uint8_t *)map, pres->format, res->dt_stride, 0, 0,
+                     transfer->box.width, transfer->box.height,
+                     (const uint8_t *)res_map, transfer->stride, 0, 0);
+      pipe_texture_unmap(pctx, transfer);
+   }
+
+   winsys->displaytarget_unmap(winsys, res->dt);
+}
+
 static void
 d3d12_flush_resource(struct pipe_context *pctx,
                      struct pipe_resource *pres)
@@ -223,6 +262,9 @@ d3d12_flush_resource(struct pipe_context *pctx,
    d3d12_apply_resource_states(ctx, false);
    d3d12_batch_reference_resource(d3d12_current_batch(ctx), res, true);
    ctx->has_commands = true;
+
+   if (res->dt && (pres->bind & PIPE_BIND_SCANOUT))
+      d3d12_present_to_displaytarget(pctx, res);
 }
 
