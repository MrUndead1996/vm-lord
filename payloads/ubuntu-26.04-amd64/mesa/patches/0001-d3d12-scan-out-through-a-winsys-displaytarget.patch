+            return false;
+         if (param == PIPE_RESOURCE_PARAM_OFFSET)
+            *value = whandle.offset;
+         else if (param == PIPE_RESOURCE_PARAM_MODIFIER)
+            *value = whandle.modifier;
+         else
+            *value = (uint64_t)(uintptr_t)whandle.handle;
