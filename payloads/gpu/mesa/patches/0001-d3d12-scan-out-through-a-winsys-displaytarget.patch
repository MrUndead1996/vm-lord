+/* Copies a scanout resource into the displaytarget its consumer scans out of.
+ *
+ * A scanout consumer -- gbm, and through it a KMS compositor -- was handed the
+ * displaytarget's DRM handle when it asked this resource for one, so the frame
+ * has to be in the displaytarget by the time the frame is handed over. The
+ * frontend flushes the back buffer before every swap, which is that moment.
+ *
+ * This is the same copy d3d12_flush_frontbuffer performs for a display target,
+ * without the presentation the winsys does afterwards: on a KMS device the
+ * consumer presents, not the winsys.
+ *
+ * The mapping is taken once and held for the life of the resource, which is
+ * not what a display target does and is the whole cost of this hop. The kms_sw
+ * winsys refcounts its mapping and munmaps the dumb BO the moment the count
+ * reaches zero, so mapping per present means mmap'ing the scanout buffer afresh
+ * every frame -- and then the copy faults in every page of it before it can
+ * write. Measured on an RTX 5070 Ti through GPU-PV at 1080p, the same copy is
+ * 2.49 ms against a mapping made per present and 0.22 ms against one that is
+ * held; 3.22 GiB/s against 35.95 GiB/s. d3d12_resource_destroy drops it.
+ */
+static void
+d3d12_present_to_displaytarget(struct pipe_context *pctx,
+                               struct d3d12_resource *res)
+{
+   struct d3d12_screen *screen = d3d12_screen(pctx->screen);
+   struct sw_winsys *winsys = screen->winsys;
+   struct pipe_resource *pres = &res->base.b;
+
+   if (!res->dt_map) {
+      res->dt_map = winsys->displaytarget_map(winsys, res->dt, 0);
+      if (!res->dt_map)
+         return;
+   }
+
+   struct pipe_transfer *transfer = nullptr;
+   void *res_map = pipe_texture_map(pctx, pres, 0, 0, PIPE_MAP_READ, 0, 0,
+                                    pres->width0, pres->height0, &transfer);
+   if (res_map) {
+      util_copy_rect((uint8_t *)res->dt_map, pres->format, res->dt_stride, 0, 0,
+                     transfer->box.width, transfer->box.height,
+                     (const uint8_t *)res_map, transfer->stride, 0, 0);
+      pipe_texture_unmap(pctx, transfer);
+      res->dt_presented = true;
+   }
+}
+
 static void
 d3d12_flush_resource(struct pipe_context *pctx,
                      struct pipe_resource *pres)
@@ -217,12 +266,27 @@ d3d12_flush_resource(struct pipe_context *pctx,
    struct d3d12_context *ctx = d3d12_context(pctx);
    struct d3d12_resource *res = d3d12_resource(pres);
 
+   /* Read before the batch reference below, which is itself a write and would
+    * otherwise clear the flag this is asking about on every call.
+    *
+    * The frontend flushes a back buffer twice per frame -- once before the swap
+    * from notify_before_flush_cb, and again from dri2_allocate_textures when the
+    * drawable is revalidated afterwards -- and nothing is drawn in between. The
+    * displaytarget already holds what the resource holds, so the second copy
+    * writes the same bytes to the same dumb BO. Skipping it halves the frame.
+    */
+   bool present = res->dt && (pres->bind & PIPE_BIND_SCANOUT) &&
+                  !res->dt_presented;
+
    d3d12_transition_resource_state(ctx, res,
                                    D3D12_RESOURCE_STATE_COMMON,
                                    D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
    d3d12_apply_resource_states(ctx, false);
    d3d12_batch_reference_resource(d3d12_current_batch(ctx), res, true);
    ctx->has_commands = true;
+
+   if (present)
+      d3d12_present_to_displaytarget(pctx, res);
 }
 
