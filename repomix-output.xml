fn network_mode_label(mode: NetworkMode) -> &'static str {
    match mode {
        NetworkMode::None => "None",
        NetworkMode::Nat => "NAT",
        NetworkMode::External => "External",
        NetworkMode::Internal => "Internal",
        NetworkMode::Unknown(_) => "Unsupported",
    }
}

