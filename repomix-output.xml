    let shared = SharedState::default();
    let mut app = WorkspaceApp::new(Box::new(FakeRepository {
        vm_state: VmState::Running {
            agent_status: AgentStatus::Online,
        },
        shared: shared.clone(),
    }));
    app.start();

    let error = app.update_vm(update_request()).unwrap_err();

    assert_eq!(
